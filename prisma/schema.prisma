generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model users {
  id            String          @id @default(uuid())
  email         String          @unique
  fullName      String
  role          Role
  assignedState String?
  assignedCity  String?
  retailerId    String?
  password      String?
  status        UserStatus      @default(INVITED)
  token         String?
  notifications notifications[]
  retailer      retailers?      @relation(fields: [retailerId], references: [id])
}

model retailers {
  id                String              @id @default(uuid())
  name              String
  region            String
  state             String
  city              String
  logistic_requests logistic_requests[]
  sales_data        sales_data[]
  users             users[]
}

// TABEL BARU: Untuk melacak riwayat upload file dataset
model dataset_uploads {
  id          String       @id @default(uuid())
  fileName    String
  fileSize    String?
  totalRows   Int
  uploadedBy  String       
  uploadedAt  DateTime     @default(now()) @db.Timestamptz(6)
  
  sales_data  sales_data[] 
}

model sales_data {
  id              String   @id @default(uuid())
  rowId           Int      @default(autoincrement()) // <-- TAMBAHKAN BARIS INI
  retailerId      String
  
  // TAMBAHAN: Relasi ke tabel upload file
  uploadId        String?  
  dataset_upload  dataset_uploads? @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  invoiceDate     DateTime @db.Timestamptz(6)
  product         String
  pricePerUnit    Float
  unitsSold       Int
  totalSales      Float
  operatingProfit Float
  operatingMargin Float
  salesMethod     String
  retailer        retailers @relation(fields: [retailerId], references: [id])

  @@index([invoiceDate])
  @@index([retailerId])
  @@index([uploadId]) // Index tambahan agar proses hapus data massal sangat cepat
}

model logistic_requests {
  id              String         @id @default(uuid())
  retailerId      String
  productCategory String
  qtyRequested    Int
  status          LogisticStatus @default(PENDING_CITY)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  retailer        retailers      @relation(fields: [retailerId], references: [id])
}

model notifications {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  user        users    @relation(fields: [userId], references: [id])
}

model audit_logs {
  id        String   @id @default(uuid())
  action    String   // Akan berisi "UPLOAD" atau "DELETE"
  fileName  String
  totalRows Int      @default(0)
  createdAt DateTime @default(now())
}

enum Role {
  DATA_ENGINEER
  SUPER_ADMIN
  STATE_ADMIN
  CITY_ADMIN
  RETAILER_ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum LogisticStatus {
  PENDING_CITY
  APPROVED_CITY
  APPROVED_STATE
  APPROVED_CENTER
  REJECTED
}