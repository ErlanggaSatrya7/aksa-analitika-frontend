generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model users {
  id            String          @id @default(uuid())
  email         String          @unique
  fullName      String
  role          Role
  assignedState String?
  assignedCity  String?         // Bisa diabaikan/dikosongkan karena tidak dipakai
  retailerId    String?         // Menunjuk ke 1 dari 6 Brand Retailer
  password      String?
  status        UserStatus      @default(INVITED)
  token         String?
  notifications notifications[]
  retailer      retailers?      @relation(fields: [retailerId], references: [id])
}

// ==========================================
// 1. TABEL RETAILER (HANYA BERISI 6 BRAND)
// ==========================================
// Kita hapus region, state, dan city dari sini. 
// Retailer adalah Brand Nasional (cth: "MATAHARI", "TRANSMART").
model retailers {
  id                String              @id
  name              String              @unique

  logistic_requests logistic_requests[]
  sales_data        sales_data[]
  users             users[]
}

model dataset_uploads {
  id             String           @id @default(uuid())
  fileName       String
  fileSize       String?
  totalRows      Int
  uploadedBy     String
  status         String           @default("SUCCESS") 
  uploadedAt     DateTime         @default(now()) @db.Timestamptz(6)
  
  sales_data     sales_data[]
  system_history system_history[] 
  model_metrics  model_metrics[]
}

// ==========================================
// 2. TABEL TRANSAKSI (SALES DATA)
// ==========================================
// Di sinilah Region dan State disimpan karena penjualan terjadi di suatu wilayah.
// Kolom 'city' sudah RESMI DIHAPUS.
model sales_data {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  invoiceDate     DateTime         @db.Timestamptz(6)
  
  // Data Geografis Pakem (6 Region, 33 State)
  region          String           
  state           String           
  
  // Data Transaksi Pakem
  product         String           // 6 Kategori Produk
  pricePerUnit    Float
  unitsSold       Int
  totalSales      Float
  operatingProfit Float
  operatingMargin Float
  salesMethod     String           // 3 Metode Sales
  
  // Relasi ke Brand Retailer (Hanya 6 pilihan)
  retailerId      String           
  uploadId        String?
  rowId           Int              @default(autoincrement())
  
  retailer        retailers        @relation(fields: [retailerId], references: [id])
  dataset_upload  dataset_uploads? @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([invoiceDate])
  @@index([retailerId])
  @@index([uploadId])
  @@index([region, state]) // Index city sudah dihapus
}

// ==========================================
// 3. TABEL PENGAJUAN LOGISTIK (BARU)
// ==========================================
model logistic_requests {
  id              String         @id @default(uuid())
  retailerId      String
  state           String         // DITAMBAHKAN: Untuk memfilter inbox Regional
  productCategory String
  qtyRequested    Int
  status          LogisticStatus @default(PENDING_REGION)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  retailer        retailers      @relation(fields: [retailerId], references: [id])
}

model notifications {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  user        users    @relation(fields: [userId], references: [id])
}

model system_history {
  id          String           @id @default(dbgenerated("gen_random_uuid()"))
  action      String
  fileName    String
  totalRows   Int              @default(0)
  status      String?
  notes       String?
  
  uploadId    String?          
  dataset     dataset_uploads? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
}

model model_metrics {
  id          String           @id @default(dbgenerated("gen_random_uuid()"))
  uploadId    String?
  mape        Float?
  mae         Float?
  r2          Float?
  created_at  DateTime         @default(now()) @db.Timestamptz(6)

  dataset     dataset_uploads? @relation(fields: [uploadId], references: [id], onDelete: Cascade)
}

// ==========================================
// ENUMS (SUDAH DIBERSIHKAN)
// ==========================================
enum Role {
  DATA_ENGINEER
  SUPER_ADMIN
  STATE_ADMIN
  RETAILER_ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum LogisticStatus {
  PENDING_REGION
  REJECTED_REGION
  PENDING_CENTER
  REJECTED_CENTER
  APPROVED_CENTER
}