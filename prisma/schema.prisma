generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model users {
  id            String        @id @default(uuid())
  email         String        @unique
  fullName      String
  role          Role
  assignedState String?
  assignedCity  String?
  retailerId    String?
  password      String?
  status        UserStatus      @default(INVITED)
  token         String?
  notifications notifications[]
  retailer      retailers?      @relation(fields: [retailerId], references: [id])
}

model retailers {
  id                String              @id @default(uuid())
  name              String
  region            String
  state             String
  city              String
  logistic_requests logistic_requests[]
  sales_data        sales_data[]
  users             users[]
}

model dataset_uploads {
  id             String           @id @default(uuid())
  fileName       String
  fileSize       String?
  totalRows      Int
  uploadedBy     String
  status         String           @default("SUCCESS") 
  uploadedAt     DateTime         @default(now()) @db.Timestamptz(6)
  
  sales_data     sales_data[]
  system_history system_history[] 
  model_metrics  model_metrics[]
}

model sales_data {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  retailerId      String
  invoiceDate     DateTime         @db.Timestamptz(6)
  
  region          String           
  state           String           
  city            String           
  
  product         String
  pricePerUnit    Float
  unitsSold       Int
  totalSales      Float
  operatingProfit Float
  operatingMargin Float
  salesMethod     String
  uploadId        String?
  rowId           Int              @default(autoincrement())
  
  retailer        retailers        @relation(fields: [retailerId], references: [id])
  dataset_upload  dataset_uploads? @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([invoiceDate])
  @@index([retailerId])
  @@index([uploadId])
  @@index([region, state, city]) 
}

model logistic_requests {
  id              String         @id @default(uuid())
  retailerId      String
  productCategory String
  qtyRequested    Int
  status          LogisticStatus @default(PENDING_CITY)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  retailer        retailers      @relation(fields: [retailerId], references: [id])
}

model notifications {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  user        users    @relation(fields: [userId], references: [id])
}

model system_history {
  id          String           @id @default(dbgenerated("gen_random_uuid()"))
  action      String
  fileName    String
  totalRows   Int              @default(0)
  status      String?
  notes       String?
  
  uploadId    String?          
  dataset     dataset_uploads? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
}

model model_metrics {
  id          String           @id @default(dbgenerated("gen_random_uuid()"))
  uploadId    String?
  mape        Float?
  mae         Float?
  r2          Float?
  created_at  DateTime         @default(now()) @db.Timestamptz(6)

  dataset     dataset_uploads? @relation(fields: [uploadId], references: [id], onDelete: Cascade)
}

enum Role {
  DATA_ENGINEER
  SUPER_ADMIN
  STATE_ADMIN
  CITY_ADMIN
  RETAILER_ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum LogisticStatus {
  PENDING_CITY
  APPROVED_CITY
  APPROVED_STATE
  APPROVED_CENTER
  REJECTED
}